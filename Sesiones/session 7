-- ======================================================================
-- ACTIVIDAD 1: Procedimiento con parámetros IN y manejo de excepciones
-- ======================================================================

CREATE OR REPLACE PROCEDURE aumentar_precio_producto (
    v_id_prod IN NUMBER,
    v_porc_aumento IN NUMBER
) AS
    v_existe NUMBER;
    v_nuevo_precio Productos.Precio%TYPE;
BEGIN
    SELECT COUNT(*) INTO v_existe 
    FROM Productos 
    WHERE ProductoID = v_id_prod;
    
    IF v_existe = 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Error: El producto con ID ' || v_id_prod || ' no está registrado en el sistema.');
    ELSE
        UPDATE Productos
        SET Precio = Precio + (Precio * (v_porc_aumento / 100))
        WHERE ProductoID = v_id_prod
        RETURNING Precio INTO v_nuevo_precio;
        
        DBMS_OUTPUT.PUT_LINE('¡Éxito! El precio del producto ' || v_id_prod || ' subió a: $' || v_nuevo_precio);
        COMMIT;
    END IF;

EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Se ha producido un error inesperado: ' || SQLERRM);
        ROLLBACK;
END;
/


-- ======================================================================
-- ACTIVIDAD 2: Procedimiento con parámetros IN y OUT
-- ======================================================================

CREATE OR REPLACE PROCEDURE contar_pedidos_cliente (
    v_id_cliente IN NUMBER,
    v_total_pedidos OUT NUMBER
) AS
BEGIN
    SELECT COUNT(PedidoID)
    INTO v_total_pedidos
    FROM Pedidos
    WHERE ClienteID = v_id_cliente;

    DBMS_OUTPUT.PUT_LINE('Procesamiento completado. El cliente ' || v_id_cliente || ' tiene ' || v_total_pedidos || ' pedidos históricos.');

EXCEPTION
    WHEN OTHERS THEN
        v_total_pedidos := 0;
        DBMS_OUTPUT.PUT_LINE('Error interno en el conteo: ' || SQLERRM);
END;
/
DECLARE
    v_resultado_conteo NUMBER;
BEGIN
    contar_pedidos_cliente(1, v_resultado_conteo);
    DBMS_OUTPUT.PUT_LINE('>> Valor capturado por la variable OUT: ' || v_resultado_conteo);
END;
/

COMMIT;
