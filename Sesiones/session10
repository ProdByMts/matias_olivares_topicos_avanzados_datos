-- ======================================================================
-- ACTIVIDAD 1: Procedimiento con Bucle FOR y Transacciones (Simple)
-- ======================================================================

CREATE OR REPLACE PROCEDURE actualizar_total_pedidos (
    p_cliente_id IN NUMBER,
    p_porcentaje IN NUMBER
) AS
BEGIN
    FOR fila IN (SELECT PedidoID FROM Pedidos WHERE ClienteID = p_cliente_id) LOOP
        
        UPDATE Pedidos
        SET Total = Total + (Total * (p_porcentaje / 100))
        WHERE PedidoID = fila.PedidoID;
        
        DBMS_OUTPUT.PUT_LINE('Se actualizó el pedido N° ' || fila.PedidoID);
        
    END LOOP;
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Proceso finalizado correctamente.');

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Ocurrió un error: ' || SQLERRM);
END;
/


-- ======================================================================
-- ACTIVIDAD 2: Procedimiento con Parámetros IN OUT (Simple)
-- ======================================================================

CREATE OR REPLACE PROCEDURE calcular_costo_detalle (
    p_detalle_id IN NUMBER,
    p_costo IN OUT NUMBER
) AS
BEGIN
    SELECT (p.Precio * d.Cantidad)
    INTO p_costo
    FROM DetallesPedidos d
    JOIN Productos p ON d.ProductoID = p.ProductoID
    WHERE d.DetalleID = p_detalle_id;

    DBMS_OUTPUT.PUT_LINE('El cálculo se realizó con éxito.');

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        p_costo := 0;
        DBMS_OUTPUT.PUT_LINE('Error: No se encontró el detalle.');
END;
/

COMMIT;
