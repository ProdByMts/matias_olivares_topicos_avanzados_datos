-- ======================================================================
-- ACTIVIDAD 1: Combinación de Función y Procedimiento
-- ======================================================================

CREATE OR REPLACE FUNCTION calcular_total_con_descuento (
    p_id_pedido IN NUMBER
) RETURN NUMBER AS
    v_monto_actual NUMBER;
    v_monto_final NUMBER;
BEGIN
    SELECT Total INTO v_monto_actual
    FROM Pedidos
    WHERE PedidoID = p_id_pedido;
    IF v_monto_actual > 1000 THEN
    ELSE
        v_monto_final := v_monto_actual;
    END IF;

    RETURN v_monto_final;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20010, 'El ID de pedido ' || p_id_pedido || ' no existe en el sistema.');
END;
/

CREATE OR REPLACE PROCEDURE aplicar_descuento_pedido (
    p_id_pedido IN NUMBER
) AS
    v_nuevo_total NUMBER;
BEGIN
    v_nuevo_total := calcular_total_con_descuento(p_id_pedido);

    UPDATE Pedidos
    SET Total = v_nuevo_total
    WHERE PedidoID = p_id_pedido;

    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Éxito: El pedido ' || p_id_pedido || ' fue actualizado a un total de: $' || v_nuevo_total);

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Error al procesar el descuento: ' || SQLERRM);
END;
/


-- ======================================================================
-- ACTIVIDAD 2: Creación de Trigger (Disparador)
-- ======================================================================

CREATE OR REPLACE TRIGGER validar_cantidad_detalle
BEFORE INSERT OR UPDATE ON DetallesPedidos
FOR EACH ROW
BEGIN
    IF :NEW.Cantidad IS NULL OR :NEW.Cantidad <= 0 THEN
        RAISE_APPLICATION_ERROR(-20020, 'Operación rechazada: La cantidad del producto debe ser obligatoriamente mayor a 0.');
    END IF;
END;
/


