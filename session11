-- ======================================================================
-- ACTIVIDAD 1: Función para calcular la edad de un cliente
-- ======================================================================

CREATE OR REPLACE FUNCTION calcular_edad_cliente (
    p_id_cli IN NUMBER
) RETURN NUMBER AS
    v_fecha_nac DATE;
    v_anios NUMBER;
BEGIN
    SELECT FechaNacimiento INTO v_fecha_nac
    FROM Clientes
    WHERE ClienteID = p_id_cli;

    v_anios := TRUNC(MONTHS_BETWEEN(SYSDATE, v_fecha_nac) / 12);

    RETURN v_anios;

EXCEPTION

    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20005, 'El Cliente con ID ' || p_id_cli || ' no existe.');
END;
/

SELECT Nombre, calcular_edad_cliente(ClienteID) AS Edad_Actual
FROM Clientes;


-- ======================================================================
-- ACTIVIDAD 2: Función de agregación y uso en SQL
-- ======================================================================

CREATE OR REPLACE FUNCTION obtener_precio_promedio 
RETURN NUMBER AS
    v_promedio NUMBER;
BEGIN
    SELECT AVG(Precio) INTO v_promedio 
    FROM Productos;
    RETURN ROUND(v_promedio, 2);
END;
/

SELECT ProductoID, Nombre, Precio
FROM Productos
WHERE Precio > obtener_precio_promedio()
ORDER BY Precio DESC;

COMMIT;
